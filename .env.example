# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
# The code reads these from the environment; secrets are never hardcoded or printed.

# --- Zendesk (READ-ONLY use only) ---
# Your Zendesk subdomain: for https://acme.zendesk.com this is "acme"
ZENDESK_SUBDOMAIN=
# The email of the API user, used for token auth as "<email>/token"
ZENDESK_EMAIL=
# A Zendesk API token (Admin Center > Apps and integrations > APIs > Zendesk API).
# A read-scoped token is sufficient and preferred — this tool only reads.
ZENDESK_API_TOKEN=

# --- Anthropic (the LLM judge) ---
ANTHROPIC_API_KEY=

# --- Dashboard ---
# Shared password to view the Streamlit dashboard. Set this before serving it.
APP_PASSWORD=

# --- BigQuery (data store) ---
# Path to a service-account key JSON with BigQuery access to the dataset below.
# GCP auth, in the order db.py tries it:
#   1. GCP_SERVICE_ACCOUNT_JSON — raw JSON. Set on Streamlit Cloud, and injected locally by
#      ../supertri_stage1/onepassword/with-op.sh from op://Supertri/GCP SA - zendesk bot.
#      This is the preferred local path: it authenticates as the same identity production uses.
#   2. Application Default Credentials — `gcloud auth application-default login`. The fallback
#      for a plain local run, and enough for read-only work.
# A key file on disk is NOT needed for either, and the one that used to live in $HOME was
# deleted on 27 Sep 2026 once the vault copy was verified. Do not reintroduce one: a private
# key sitting loose in a home directory is exactly what the 1Password wiring exists to end.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json   # legacy, unused
BQ_PROJECT=supertri-chat-bot
BQ_DATASET=zendesk_bot
BQ_LOCATION=EU
