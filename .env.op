# 1Password secret REFERENCES for zendesk-bot-dashboard — no secret values. Safe to commit.
#
#   ../supertri_stage1/onepassword/with-op.sh ./run_daily.sh
#
# config.py calls load_dotenv() WITHOUT override=True, so these win over .env.

ZENDESK_SUBDOMAIN=op://Supertri/Zendesk API - read-only/subdomain
ZENDESK_EMAIL=op://Supertri/Zendesk API - read-only/email
ZENDESK_API_TOKEN=op://Supertri/Zendesk API - read-only/api_token

ANTHROPIC_API_KEY=op://Supertri/Anthropic API key/credential

# Shared viewer gate on the Streamlit dashboard.
APP_PASSWORD=op://Supertri/Zendesk dashboard app password/credential

# RAW service-account JSON (db.py reads it as JSON, not a path) — LIVE since 27 Sep 2026.
# The vault item is populated (verified byte-identical to ~/zendesk-bot-key.json), so the
# all-or-nothing `op run` caveat no longer applies and this line is enabled.
#
# EFFECT: under with-op.sh, db.py takes its path 1 (raw JSON) and authenticates as
# zendesk-bot-dashboard@supertri-chat-bot — the same identity the deployed app uses, rather
# than your personal ADC. That is the point: local runs now match production. Without
# with-op.sh nothing changes; db.py still falls back to ADC / GOOGLE_APPLICATION_CREDENTIALS.
GCP_SERVICE_ACCOUNT_JSON=op://Supertri/GCP SA - zendesk bot/credential

# AI agents (Ultimate) data export key — AI agents dashboard ▸ Organization management ▸ API key.
# Regenerated 30 Sep 2026 (the previous key was unrecorded). Bot/org ids live in config.py.
AI_AGENTS_API_KEY=op://Supertri/srgiq453523suc4pxtstlcbxku/credential
