# 1Password secret REFERENCES for zendesk-bot-dashboard — no secret values. Safe to commit.
#
#   ../supertri_stage1/onepassword/with-op.sh ./run_daily.sh
#
# config.py calls load_dotenv() WITHOUT override=True, so these win over .env.

ZENDESK_SUBDOMAIN=op://Supertri/Zendesk API - read-only/subdomain
ZENDESK_EMAIL=op://Supertri/Zendesk API - read-only/email
ZENDESK_API_TOKEN=op://Supertri/Zendesk API - read-only/api_token

ANTHROPIC_API_KEY=op://Supertri/Anthropic API key/credential

# Shared viewer gate on the Streamlit dashboard.
APP_PASSWORD=op://Supertri/Zendesk dashboard app password/credential

# RAW service-account JSON (db.py reads it as JSON, not a path).
# ── DISABLED until the vault item is populated ───────────────────────────────────────
# `op run` is ALL-OR-NOTHING: a single unresolvable reference aborts the whole command, so
# an empty item here would block every local run. Local dev uses Application Default
# Credentials (gcloud auth application-default login), so this is not needed locally — the
# raw JSON is only required on Streamlit Cloud. Paste the key into the vault item, then
# uncomment this line.
# GCP_SERVICE_ACCOUNT_JSON=op://Supertri/GCP SA - zendesk bot/credential
